# === RouterAI (OpenAI-compatible, РФ) ===
# Приоритетный провайдер для мультиагентной системы
ROUTERAI_API_KEY=sk-your-routerai-api-key
ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# === Fallback: OpenRouter (если RouterAI недоступен) ===
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === Модель LLM по умолчанию для всех агентов ===
LLM_MODEL=deepseek/deepseek-v4-flash

# === Переопределение моделей для каждого агента (опционально) ===
# RESEARCHER_MODEL=deepseek/deepseek-v4-flash
# WRITER_MODEL=deepseek/deepseek-v4-flash
# EDITOR_MODEL=deepseek/deepseek-v4-flash
# PUBLISHER_MODEL=deepseek/deepseek-v4-flash

# === Fallback-поиск: Yandex Search API (Yandex Cloud) ===
# Документация: https://cloud.yandex.com/docs/search-api/
# 1. Создайте каталог в Yandex Cloud
# 2. Создайте API-ключ с ролью ai.search
# 3. Укажите FOLDER_ID вашего каталога
YANDEX_API_KEY=your-yandex-api-key
YANDEX_FOLDER_ID=your-yandex-folder-id

# === Tavily Search API (глобальный fallback для преподавателя) ===
# Документация: https://docs.tavily.com/
# Получить ключ: https://app.tavily.com/
TAVILY_API_KEY=
